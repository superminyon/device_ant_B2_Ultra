# default is the init flow for the project without AGO settings
#Antaiui <AI_BSP_ZRAM> <yaoyc> <2022-04-07> add for zram writeback feature begin
on property:vold.post_fs_data_done=1 && property:persist.sys.aiui.swapsize=0
    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/swappiness 100
    write /sys/kernel/mm/swap/vma_ra_enabled false
    swapon_all /vendor/etc/fstab.enableswap

on property:vold.post_fs_data_done=1 && property:persist.sys.aiui.swapsize=2
    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/swappiness 100
    write /sys/kernel/mm/swap/vma_ra_enabled false
    swapon_all /vendor/etc/fstab.enableswap_ant

